NEXT_PUBLIC_API_URL=/v1
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_HST_PERCENT=13
# Estimated rate: update this value to the current CAD/CNY rate.
NEXT_PUBLIC_CAD_TO_CNY=5.0
# Set your public Mapbox token locally; never commit .env.local.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: leave empty to disable telemetry. Do Not Track is respected.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
